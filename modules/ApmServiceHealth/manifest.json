{
	"manifest_version": 2.0,
	"id": "apmservicehealth",
	"type": "widget",
	"name": "APM service health",
	"namespace": "ApmServiceHealth",
	"version": "1.9.0",
	"author": "Simon Alex Rodriguez",
	"url": "https://github.com/SimonLexRS/zabbix-apm-dashboard",
	"description": "Dashboard widget: health of APM services (requests, error rate, p50/p95/p99 and a per-minute trend) with color thresholds. English and Spanish.",
	"widget": {
		"size": {
			"width": 36,
			"height": 6
		},
		"js_class": "CWidgetApmServiceHealth",
		"refresh_rate": 10,
		"in": {
			"time_period": {
				"type": "_timeperiod"
			}
		}
	},
	"actions": {
		"widget.apmservicehealth.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"css": ["widget.css"],
		"js": ["class.widget.js"]
	}
}
