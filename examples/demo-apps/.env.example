# Copy to .env (cp .env.example .env) and change what you need.
COMPOSE_PROJECT_NAME=apm-demo-apps

# Where the containers find the Collector of Zabbix APM. host.docker.internal is this host (172.17.0.1); use the
# address of the Zabbix server if the Collector runs elsewhere.
ZABBIX_APM_HOST=host.docker.internal

# Local port of the Go example (http://127.0.0.1:8090).
GO_EXAMPLE_PORT=8090
